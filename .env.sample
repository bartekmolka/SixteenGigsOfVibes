# Optional settings for start.sh — copy this file:
#   cp .env.sample .env
# The .env file is not tracked by git. Every variable is optional;
# omitting it = the default value from start.sh.
#
# Precedence (highest first):
#   1. variables exported in the shell
#   2. entries in ./.env
#   3. start.sh defaults

# ---- model -------------------------------------------------------------------
# qwen38   | empero-ai/Qwen3.8-9B-Distill-GGUF   Q4_K_M  (5.78 GB) — default
# ornith   | bartowski/Ornith-1.5-9B-GGUF        Q4_K_M  (5.91 GB)
# bonsai27 | prism-ml/Ternary-Bonsai-2-27B-gguf  Q2_0    (7.63 GB)
#MODEL=qwen38

# Override the preset file (a single GGUF file inside the repo).
#HF_REPO=
#HF_FILE=
#MODEL_ALIAS=

# Download the vision projector and enable image input (qwen38 has no projector).
#VISION=1

# Pin to a specific repo commit (defaults to main).
#HF_REVISION=

# HuggingFace token (higher download rate limits; public repos work without one).
#HF_TOKEN=

# ---- server ------------------------------------------------------------------
# Backend: auto (defaults to: cuda > rocm > vulkan > cpu) | cuda | rocm | vulkan | cpu
#BACKEND=auto

# Override the image tag; without it, one is picked automatically per backend.
#IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda

#CONTAINER_NAME=SixteenGigsOfVibes-llama
#PORT=8080
#MODEL_DIR=./models
#LOG_FILE=./.SixteenGigsOfVibes.log
#READY_TIMEOUT=600

# Context window in tokens. Defaults to 32768 (9B models) / 16384 (bonsai27).
# On 16 GB lower it when the machine is under load — changing it does not
# require re-downloading the model.
#CTX_SIZE=32768

# Number of server slots (sessions); the context is split between them.
#PARALLEL=1

# KV cache type (e.g. q8_0) — halves the KV memory footprint at a slight quality cost.
# The bonsai27 preset sets q8_0 by default.
#KV_CACHE_TYPE=q8_0

# Extra arguments for `podman run` (space-separated).
#PODMAN_EXTRA_ARGS=
